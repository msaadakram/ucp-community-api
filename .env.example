# Local dev only (Heroku/Vercel use `heroku config` / `vercel env`).
# Never commit real keys.

# --- Community (REQUIRED) -------------------------------------------------
# These two are the only hard requirement: without them getConfig().ok is
# false, /api/health answers 500 {"ok":false} and EVERY community route
# fails. The service-role key must never reach a client.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Odoo/Horizon base URL used to verify the student's portal session.
ODOO_BASE=https://horizon.ucp.edu.pk

# Allowed CORS origin. `*` for the pilot; an exact origin in production.
CORS_ORIGIN=*

# --- Extension / admin ----------------------------------------------------
# MongoDB Atlas connection for the /api/ext/* surface.
# Unset => ext routes answer 503; community routes keep working.
MONGODB_URI=

# REQUIRED IN PRODUCTION: /api/ext/* requests must send
#   x-api-key: <EXT_API_KEY>
# Unset => ext routes fail closed (401).
#
# The SAME value must exist in THREE places — rotate all three together:
#   1. here (server env)
#   2. ../ucp-live-grading-extenstion/src/config.js  (EXT_API_KEY)
#   3. the Flutter app build: --dart-define=EXT_API_KEY=...
#
# NOTE: the key ships inside the extension bundle, so it is PUBLIC to anyone
# who installs the extension. It gates /api/ext/* from random internet
# callers; it is NOT student authentication and does NOT identify a student.
EXT_API_KEY=

# REQUIRED IN PRODUCTION: admin panel login (user `admin`).
# There is no default password any more — unset => admin login is disabled.
# Use a strong random value. `ensureDefaultAdmin` re-hashes this on every
# boot, so rotating it here always overrides whatever is stored in Mongo.
ADMIN_PASSWORD=

# Key material for sealing cookie-vault values at rest (AES-256-GCM).
# Use a real random secret (e.g. `openssl rand -hex 32`). Do NOT leave it
# blank and do NOT reuse a placeholder: when this is unset the code falls
# back to deriving the key from EXT_API_KEY, which is published in the
# extension — that makes "a DB dump alone yields no usable sessions" false.
COOKIE_VAULT_KEY=

# --- Earn / referrals (optional) ------------------------------------------
# Reward credits per successful referral claim (default 50).
CREDITS_REWARD=50

# Public host, used to build earn referral links (<BASE_URL>/token/<token>).
# Falls back to http://localhost:3000 if unset — set it in production.
BASE_URL=https://ucp.animezone.me
