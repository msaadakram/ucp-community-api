# Local dev only (Heroku uses `heroku config`). Never commit real keys.

# --- Community (required) ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
ODOO_BASE=https://horizon.ucp.edu.pk
CORS_ORIGIN=*

# --- Extension / admin (all optional; ext routes 503 without Mongo) ---
# MongoDB Atlas connection for the /api/ext/* surface.
MONGODB_URI=

# REQUIRED IN PRODUCTION: /api/ext/* requests must send
#   x-api-key: <EXT_API_KEY>
# (the Chrome extension ships this key). Unset => ext routes fail closed.
EXT_API_KEY=

# REQUIRED IN PRODUCTION: admin panel login (user `admin`).
# No default password exists any more — unset => admin login is disabled.
ADMIN_PASSWORD=

# Optional: dedicated key for sealing cookie-vault values at rest
# (AES-256-GCM). Falls back to a key derived from EXT_API_KEY.
COOKIE_VAULT_KEY=

# --- Earn / referrals (optional) ---
# Reward credits per successful referral claim (default 50).
CREDITS_REWARD=50
