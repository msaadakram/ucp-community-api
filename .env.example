# Local dev only (Vercel uses its own Environment Variables screen).
# Never commit real keys.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...service_role...only...
ODOO_BASE=https://horizon.ucp.edu.pk
CORS_ORIGIN=*

# Extension (/api/ext/*) — Mongo-backed grade/leaderboard/credit server.
# Optional: when MONGODB_URI is unset, ext routes answer 503 while the
# community routes keep working.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ucp
CREDITS_REWARD=50
BASE_URL=http://localhost:3000
CUTY_API_TOKEN=
CUTY_API_BASE_URL=https://cuty.io/api
CUTY_TIMEOUT_MS=8000

# Admin control panel (/admin) — REQUIRED in production.
# Overrides the seeded admin/admin password on first boot only.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_PASSWORD=change-me-in-production
NODE_ENV=production

